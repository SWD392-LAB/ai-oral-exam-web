# Copy to .env.local (not committed)
VITE_API_BASE_URL=http://localhost:5080
# true: every service call except sign-in is answered from src/mocks; false: calls the real API
VITE_USE_MOCKS=true

# Keycloak (OpenID Connect). The dev server must run on port 5173.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/aives
VITE_OIDC_CLIENT_ID=aives-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/sign-in
VITE_OIDC_SCOPE=openid profile email
