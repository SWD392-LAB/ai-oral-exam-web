        </mxCell>
        <mxCell id="enum_TokenPurpose" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Arial;fillColor=#FFF8E1;strokeColor=#8D6E63;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;font-size:11px;&quot;&gt;«enumeration»&lt;/p&gt;&lt;p style=&quot;margin:0px;text-align:center;font-size:13px;&quot;&gt;&lt;b&gt;TokenPurpose&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;line-height:16px;&quot;&gt;AccountSetup&lt;br&gt;PasswordReset&lt;br&gt;EmailVerification&lt;/p&gt;" vertex="1">
          <mxGeometry x="40" y="1642" width="185" height="100" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=12;" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;◆ composition (the part cannot exist without the whole)&lt;br&gt;◇ aggregation (the part can exist on its own)&lt;br&gt;▷ inheritance &amp;nbsp;·&amp;nbsp; plain line = association&lt;br&gt;- private &amp;nbsp;+ public &amp;nbsp;·&amp;nbsp; [0..1] = optional value&lt;br&gt;&lt;u&gt;underlined&lt;/u&gt; = class-level (static) operation&lt;br&gt;&lt;br&gt;&lt;b&gt;Mapping to the ERD&lt;/b&gt;&lt;br&gt;Every ERD entity except ROLE has a class of the same name. ROLE is modelled by the UserRole enumeration and the subclasses Student, Lecturer and Administrator of User; the role value decides which subclass a user is.&lt;br&gt;&lt;br&gt;&lt;b&gt;Scores&lt;/b&gt;&lt;br&gt;A ScoreReview starts as Pending, at the sum of the AI scores. The score counts as confirmed only when its status is Approved (the attempt is then Finalized). A question not reached before the session closes has no QuestionResponse and counts as 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not shown as operations&lt;/b&gt;&lt;br&gt;Log in and Log out run in the API layer (Authentication, JWT); the classes keep only the data they use: accountName, email, passwordHash, passwordSalt and googleLinked. TTS, STT, follow-up generation and rubric scoring run in the AI adapters; the classes keep their results (InterviewTurn, AIEvaluation)." vertex="1">
          <mxGeometry x="560" y="1420" width="420" height="400" as="geometry" />
        </mxCell>
