        <mxCell id="enum_Language" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=12;fontFamily=Arial;fillColor=#FFF8E1;strokeColor=#8D6E63;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;font-size:11px;&quot;&gt;«enumeration»&lt;/p&gt;&lt;p style=&quot;margin:0px;text-align:center;font-size:13px;&quot;&gt;&lt;b&gt;Language&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;line-height:16px;&quot;&gt;Vietnamese&lt;br&gt;English&lt;/p&gt;" vertex="1">
